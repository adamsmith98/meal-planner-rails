<ul class="list-group my-3" style="max-width: 40%">
    <% @shopping_list_items.each do |shopping_list_item| %>
        <li class="list-group-item align-items-center" style="display: flex; justify-content: space-between">
            <span style="font-size: 1.25em">
                <%= shopping_list_item.recipe_ingredient.name %>
            </span>
            <span>
                <%= button_to shopping_list_item, method: :delete, class: "btn btn-danger" do %>
                    <i class="bi bi-x-lg"></i>
                <% end %>
            </span>
        </li>
    <% end %>
</ul>
